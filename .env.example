# Accounts are optional. Leave these unset for a guest-only deployment.
# Never put secrets or a database URL in NEXT_PUBLIC_* variables.

# Hosted PostgreSQL URL (postgresql:// or postgres://) for dev:prisma and deployment.
# dev/dev:local override DATABASE_URL with Docker PostgreSQL on 127.0.0.1:5433.
# Keep auth settings in .env.development.local for local development.
DATABASE_URL=

# Better Auth: a random secret of at least 32 characters and the app origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps; callback URL: <BETTER_AUTH_URL>/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
