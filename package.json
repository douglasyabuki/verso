    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "5.5.207",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.6",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
