{
  "name": "verso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:local --",
    "build": "npm run compiler:build && prisma generate && next build",
    "vercel-build": "npm run compiler:build && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "compiler:prepare": "node tools/compiler-proof/prepare.mjs",
    "compiler:build": "node tools/compiler-proof/prepare.mjs --assets-only --if-needed",
    "compiler:proof": "node tools/compiler-proof/serve.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "fix": "npm run format && npm run lint:fix",
    "test": "npm run test:unit && npm run test:db && npm run test:browser && npm run test:e2e && npm run test:e2e:accounts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:accounts": "playwright test --config=playwright.accounts.config.ts --project=chromium",
    "test:e2e:accounts:all": "playwright test --config=playwright.accounts.config.ts",
    "test:measure": "playwright test --config=playwright.measure.config.ts",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:db": "prisma generate && vitest run --project db",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "dev:local": "node tools/database.mjs local dev",
    "dev:prisma": "node tools/database.mjs prisma dev",
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose down",
    "db:local:migrate": "node tools/database.mjs local migrate",
    "db:prisma:migrate": "node tools/database.mjs prisma migrate"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "better-auth": "1.7.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "diff": "8.0.4",
    "fflate": "0.8.3",
    "lucide-react": "^1.59.0",
    "next": "16.4.6",
    "pdfjs-dist": "5.5.207",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.6",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.2.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "@ts-morph/common": {
      "minimatch": "11.0.8"
    }
  }
}
